  RFLAGS.setSF (← UNSPECIFIED (size := 1))
  RFLAGS.setZF (← UNSPECIFIED (size := 1))
  RFLAGS.setAF (← UNSPECIFIED (size := 1))
  RFLAGS.setPF (← UNSPECIFIED (size := 1))
