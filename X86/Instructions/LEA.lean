def Instructions.Operations.LEA
    (operand_size : Int) (effective_address : Bits 64) :
    Except (Runtime.Error Empty) (Bits operand_size) := do
  Runtime.assert (operand_size == 8 || operand_size == 16 || operand_size == 32 || operand_size == 64)

  let result : Bits operand_size ← effective_address[0 +: operand_size]
  return result

